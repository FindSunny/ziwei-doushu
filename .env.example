# 复制为 .env.local 后填入实际值

# ─── DeepSeek 云端解读（本地排盘不用填写）───
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─── AI 每日额度 ───
# 全站每天最多发起多少次 DeepSeek 请求，默认 500
AI_QUOTA_DAILY_LIMIT=500
# 额度用完后展示的联系方式；正式公开前请改成真实联系方式
AI_QUOTA_CONTACT=站点管理员
# 生产环境建议放到应用目录外并确保运行用户可读写
# AI_QUOTA_STORE=/var/lib/ziwei-doupan/ai-quota.json

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
